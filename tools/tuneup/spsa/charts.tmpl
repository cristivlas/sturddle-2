                    canvas.addEventListener('touchend', function() {{ _endDrag(typeof Chart !== 'undefined' && Chart.getChart && Chart.getChart(canvas)); }});
                    try {{
                        var _ip = JSON.parse(localStorage.getItem('insetPos'));
                        if (_ip && _ip.x != null) {{
                            var _ich = typeof Chart !== 'undefined' && Chart.getChart && Chart.getChart(canvas);
                            if (_ich) _ich._insetPos = _ip;
                        }}
                    }} catch(e) {{}}
                }})();

                makeChart('eloChart', history.map(h => ({{x: h.iteration, y: h.elo_diff}})), 'ELO Diff', '#e91e63');
                makeChart('akChart', history.map(h => ({{x: h.iteration, y: h.a_k}})), 'a_k', '#2196F3');
                makeChart('ckChart', history.map(h => ({{x: h.iteration, y: h.c_k}})), 'c_k', '#FF9800');
                applyChartTheme();

                // Restore solo param + view mode
                if (_soloParam) {{
                    var _rch = typeof Chart !== 'undefined' && Chart.getChart && Chart.getChart(document.getElementById('thetaChart'));
                    if (_rch) {{
                        // Hide canvas through the restore: in pert mode we wait
                        // for _spsaC/_spsaGamma (so _reapplySoloRange can swap to
                        // pert data), in value mode we wait for paramRanges (so
