                // Apply saved zoom now that charts and _pending are populated
                if (_restoredZoom) applyZoomRange(_restoredZoom[0], _restoredZoom[1]);
                window.updateThetaSubtitle();
            }} catch (e) {{
                console.error('Failed to render charts', e);
            }}
        }})();
    // Update chart legend visibility on resize. Only the main theta chart
    // has a conditional legend; other charts (ELO, a_k, c_k) keep legend
    // permanently hidden per their own options, so don't touch them.
    var _resizeTimer;
    window.addEventListener('resize', function() {{
        clearTimeout(_resizeTimer);
        _resizeTimer = setTimeout(function() {{
            var show = window.innerWidth > 700;
            document.querySelectorAll('canvas').forEach(function(c) {{
                var ch = typeof Chart !== 'undefined' && Chart.getChart && Chart.getChart(c);
                if (!ch) return;
                if (c.id === 'thetaChart') {{
                    ch.options.plugins.legend.display = show;
