                            var textFallback = darkInset ? '#e8e8ec' : '#333';
                            lines.forEach(function(l, i) {{
                                ctx.fillStyle = (l.color === 'theme:text')
                                    ? _cssColor('--text', textFallback)
                                    : l.color;
                                ctx.fillText(l.text, ix + pad, iy + pad + i * lh);
                            }});
                            ctx.restore();
                        }}
                    }}]
                }});
                (function() {{
                    var canvas = document.getElementById('thetaChart');
                    var _drag = null;
                    function _insetHit(ch, mx, my) {{ var b = ch._insetBox; return b && mx >= b.x && mx <= b.x + b.w && my >= b.y && my <= b.y + b.h; }}
                    function _startDrag(ch, mx, my, e) {{ var b = ch._insetBox; _drag = {{ ox: mx - b.x, oy: my - b.y }}; e.stopPropagation(); }}
                    function _moveDrag(ch, mx, my, e) {{ ch._insetPos = {{ x: mx - _drag.ox, y: my - _drag.oy }}; ch.update('none'); e.stopPropagation(); }}
                    function _endDrag(ch) {{ if (ch && ch._insetPos) try {{ localStorage.setItem('insetPos', JSON.stringify(ch._insetPos)); }} catch(e) {{}} _drag = null; }}
                    canvas.addEventListener('mousedown', function(e) {{
                        var ch = typeof Chart !== 'undefined' && Chart.getChart && Chart.getChart(canvas);
                        if (!ch || !ch._insetBox) return;
                        var r = canvas.getBoundingClientRect();
                        var mx = e.clientX - r.left, my = e.clientY - r.top;
                        if (_insetHit(ch, mx, my)) _startDrag(ch, mx, my, e);
                    }});
                    canvas.addEventListener('mousemove', function(e) {{
                        var ch = typeof Chart !== 'undefined' && Chart.getChart && Chart.getChart(canvas);
                        if (!ch) return;
                        var r = canvas.getBoundingClientRect();
                        var mx = e.clientX - r.left, my = e.clientY - r.top;
