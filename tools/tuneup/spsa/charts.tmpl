                    canvas.addEventListener('mouseup', function() {{ _endDrag(typeof Chart !== 'undefined' && Chart.getChart && Chart.getChart(canvas)); }});
                    canvas.addEventListener('mouseleave', function() {{ _drag = null; }});
                    canvas.addEventListener('touchstart', function(e) {{
                        var ch = typeof Chart !== 'undefined' && Chart.getChart && Chart.getChart(canvas);
                        if (!ch || !ch._insetBox) return;
