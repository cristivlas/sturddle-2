                    }}, {{ passive: false }});
                    canvas.addEventListener('touchmove', function(e) {{
                        if (!_drag) return;
                        var ch = typeof Chart !== 'undefined' && Chart.getChart && Chart.getChart(canvas);
                        if (!ch) return;
                        var t = e.touches[0], r = canvas.getBoundingClientRect();
