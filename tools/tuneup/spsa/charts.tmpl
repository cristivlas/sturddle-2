                        _rds.forEach(function(d) {{
                            if (d.label === _soloParam) {{
                                d.hidden = false;
                                if (_rRange) d.data = _origData[_soloParam].map(function(pt) {{ return {{x: pt.x, y: pt.y != null ? denorm(pt.y, _rRange[0], _rRange[1]) : null}}; }});
                                else d.data = _origData[_soloParam].slice();
                            }} else {{ d.hidden = true; }}
                        }});
                        if (_rRange) {{ _rch.options.scales.y.min = _rRange[0]; _rch.options.scales.y.max = _rRange[1]; }}
                        _rch.options.plugins.title.display = true;
