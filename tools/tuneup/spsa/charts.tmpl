                                        var pyBot = ys.getPixelForValue(st.yEnd - ck);
                                        var brTop = Math.min(pyTop, pyBot), brBot = Math.max(pyTop, pyBot);
                                        var darkBr = document.documentElement.getAttribute('data-theme') === 'dark';
                                        ctx.strokeStyle = darkBr ? 'rgba(200,200,205,1.0)' : 'rgba(80,80,80,1.0)';
                                        ctx.lineWidth = 3;
                                        ctx.lineCap = 'round';
