                                ctx.lineWidth = 1;
                                ctx.setLineDash([4, 4]);
                                ctx.beginPath();
                                ctx.moveTo(ca.left, py0); ctx.lineTo(ca.right, py0);
                                ctx.stroke();
                                ctx.setLineDash([]);
