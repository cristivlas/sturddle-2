                            ctx.lineWidth = 4;
                            // 'd9' ~ 85% alpha
                            ctx.strokeStyle = darkHalo ? (_cssColor('--surface', '#1e1f26') + 'd9') : '#ffffffd9';
                            ctx.lineJoin = 'round';
                            // ±cₖ label on top of line
                            var clp = chart._ckLabelPos;
                            if (clp) {{
                                ctx.fillStyle = darkHalo ? 'rgba(200,200,205,1.0)' : 'rgba(80,80,80,1.0)';
                                ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
                                var lbl = '±cₖ';
                                var lx = clp.px - clp.tick - 8;
                                if (lx - ctx.measureText(lbl).width < ca.left + 2) {{
                                    ctx.textAlign = 'left';
                                    lx = clp.px + clp.tick + 8;
                                }}
                                ctx.strokeText(lbl, lx, clp.py);
                                ctx.fillText(lbl, lx, clp.py);
                            }}
                            // θ₀ label on top of line
                            if (chart._theta0LabelY != null) {{
                                ctx.fillStyle = darkHalo ? 'rgba(200,200,205,1.0)' : 'rgba(80,80,80,1.0)';
                                ctx.textAlign = 'left'; ctx.textBaseline = 'bottom';
                                ctx.strokeText('θ₀', ca.left + 4, chart._theta0LabelY - 3);
                                ctx.fillText('θ₀', ca.left + 4, chart._theta0LabelY - 3);
                            }}
                            ctx.restore();
                        }}
                    }}, {{
                        id: 'insetSub',
                        afterDraw: function(chart) {{
                            var s1 = chart._sub1, s2 = chart._sub2, s3 = chart._sub3, s4 = chart._sub4, s5 = chart._sub5;
                            if (!s1 && !s2 && !s3 && !s4 && !s5) {{ chart._insetBox = null; return; }}
                            var ctx = chart.ctx, ca = chart.chartArea;
                            ctx.save();
                            ctx.font = 'bold 14px ' + (Chart.defaults.font.family || 'sans-serif');
                            var lines = [];
                            if (s1) lines.push(s1);
                            if (s2) lines.push(s2);
                            if (s3) lines.push(s3);
                            if (s4) lines.push(s4);
                            if (s5) lines.push(s5);
                            var pad = 6, lh = 20;
                            var w = Math.max.apply(null, lines.map(function(l) {{ return ctx.measureText(l.text).width; }})) + pad * 2;
                            var h = lines.length * lh + pad * 2 - 2;
                            var ix, iy;
                            if (chart._insetPos) {{
                                ix = Math.max(ca.left + 4, Math.min(ca.right - w - 4, chart._insetPos.x));
                                iy = Math.max(ca.top + 4, Math.min(ca.bottom - h - 4, chart._insetPos.y));
                            }} else {{
                                ix = ca.right - w - 8; iy = ca.top + 8;
                            }}
                            chart._insetBox = {{ x: ix, y: iy, w: w, h: h }};
                            var darkInset = document.documentElement.getAttribute('data-theme') === 'dark';
                            // hex8: 'e0' ~ 88% alpha, 'd0' ~ 82%
