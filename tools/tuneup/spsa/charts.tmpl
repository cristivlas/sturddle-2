                            ctx.strokeStyle = darkInset ? 'rgba(255,255,255,0.18)' : 'rgba(0,0,0,0.10)';
                            ctx.lineWidth = 1;
                            ctx.beginPath();
                            ctx.roundRect(ix, iy, w, h, 4);
                            ctx.fill(); ctx.stroke();
