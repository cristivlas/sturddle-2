                            ctx.rect(ca.left, ca.top, ca.right - ca.left, ca.bottom - ca.top);
                            ctx.clip();
                            // ±1σ band around mean (sigma is from sqrt(sum of
                            // squares / n), so always finite & non-negative)
                            if (st && st.sigma > 0) {{
                                var yLo = ys.getPixelForValue(st.mean - st.sigma);
                                var yHi = ys.getPixelForValue(st.mean + st.sigma);
                                var top = Math.min(yLo, yHi), bot = Math.max(yLo, yHi);
                                ctx.fillStyle = 'rgba(102,126,234,0.10)';
                                ctx.fillRect(ca.left, top, ca.right - ca.left, bot - top);
                                // Mean line
                                var ym = ys.getPixelForValue(st.mean);
                                ctx.strokeStyle = 'rgba(102,126,234,0.55)';
                                ctx.lineWidth = 1;
                                ctx.setLineDash([]);
                                ctx.beginPath();
                                ctx.moveTo(ca.left, ym); ctx.lineTo(ca.right, ym);
                                ctx.stroke();
                            }}
                            // Current cₖ half-band bracket at right edge of visible window
                            if (_spsaC != null && _spsaGamma != null && st) {{
                                var ir = paramInternalRanges[_soloParam];
                                if (ir) {{
                                    var scale = st.rangeKnown ? (st.range[1] - st.range[0]) : ir;
                                    var ck = _spsaC / Math.pow(st.iterTo + 1, _spsaGamma) * scale;
                                    if (isFinite(ck) && ck > 0) {{
                                        var px = xs.getPixelForValue(st.iterTo);
