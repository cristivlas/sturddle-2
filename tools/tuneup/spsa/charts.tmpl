                            }} else {{
                                chart._theta0LabelY = null;
                            }}
                            ctx.restore();
                        }},
                        afterDatasetsDraw: function(chart) {{
                            if (!_soloParam || _pertView !== 'value') return;
                            var ca = chart.chartArea;
                            var ctx = chart.ctx;
                            ctx.save();
                            ctx.beginPath();
                            ctx.rect(ca.left, ca.top, ca.right - ca.left, ca.bottom - ca.top);
